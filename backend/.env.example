# Port configuration
PORT=5000
NODE_ENV=production

# Database Connection String
DATABASE_URL="file:./dev.db"

# Authentication Configs
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# Redis Cache URI (set to enable performance caching, otherwise mock memory is active)
REDIS_URL=redis://localhost:6379

# Cloudinary Credentials (set to enable image uploads, otherwise simulated)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer Settings (set to enable customer receipt emails)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# OTP code provider option (development | firebase)
OTP_PROVIDER=development
