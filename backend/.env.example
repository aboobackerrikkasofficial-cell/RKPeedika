# Port configuration
PORT=5000
NODE_ENV=production

# Database Connection String
DATABASE_URL=postgresql://user:password@host:port/dbname

# Authentication Configs
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis Cache URI (set to enable performance caching, otherwise mock memory is active)
REDIS_URL=

# Cloudinary Credentials (set to enable image uploads, otherwise simulated)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer Settings (set to enable customer receipt emails)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OTP code provider option (development | firebase)
OTP_PROVIDER=firebase

# Frontend URLs for CORS
FRONTEND_URL=https://rkpeedika-customer.onrender.com,https://rkpeedika-admin.onrender.com

# Initial Admin Credentials (used during bootstrap)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Logistics Tracking API (TrackingMore - Free signup at trackingmore.com)
TRACKINGMORE_API_KEY=
